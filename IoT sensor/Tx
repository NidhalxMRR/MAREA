#include <Wire.h>
#include <SPI.h>
#include <LoRa.h>

#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>

#include <OneWire.h>
#include <DallasTemperature.h>

#include <TinyGPS++.h>

// =====================================================
// PIN DEFINITIONS (TTGO LORA32 V1.3 SX1276)
// =====================================================

// I2C
#define I2C_SDA          21
#define I2C_SCL          22

// DS18B20
#define DS18B20_PIN      13

// GPS
#define GPS_RX_PIN       34   // GPS TX -> ESP32 GPIO34
#define GPS_TX_PIN       12   // ESP32 GPIO12 -> GPS RX

// OLED
#define OLED_RST         16

// TTGO LoRa SPI
#define LORA_SCK         5
#define LORA_MISO        19
#define LORA_MOSI        27
#define LORA_SS          18
#define LORA_RST         14
#define LORA_DIO0        26

// =====================================================
// LORA SETTINGS
// =====================================================

#define LORA_FREQ        868.8E6
#define LORA_TX_POWER    10
#define LORA_BANDWIDTH   125E3
#define LORA_SF          7
#define LORA_CR          5
#define LORA_SYNC_WORD   0x12

#define SENSOR_INTERVAL  2000UL
#define LORA_INTERVAL    32000UL

// =====================================================
// OBJECT DECLARATIONS
// =====================================================

#define SCREEN_WIDTH     128
#define SCREEN_HEIGHT    64

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RST);
Adafruit_MPU6050 mpu;
OneWire oneWire(DS18B20_PIN);
DallasTemperature ds18b20(&oneWire);
HardwareSerial gpsSerial(2);
TinyGPSPlus gps;

// =====================================================
// GLOBAL VARIABLES & TIMING
// =====================================================

unsigned long lastSensorUpdate = 0;
unsigned long lastLoRaSend = 0;

uint8_t displayPage = 0;
uint32_t sequenceNumber = 0;
bool loraOK = false;

float currentTemp = 0.0;
float currentAX = 0.0, currentAY = 0.0, currentAZ = 0.0;
float currentGX = 0.0, currentGY = 0.0, currentGZ = 0.0;
bool currentGpsValid = false;
double currentLatitude = 0.0, currentLongitude = 0.0;
uint32_t currentSatellites = 0;
float currentAltitude = 0.0;
float currentHDOP = 0.0;

// =====================================================
// SETUP
// =====================================================

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("\n==========================================");
  Serial.println(" TTGO SENSOR + GPS + LORA TRANSMITTER");
  Serial.println("==========================================");

  // 1. I2C Bus
  Wire.begin(I2C_SDA, I2C_SCL);

  // 2. OLED Display
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("[-] OLED allocation failed!"));
  } else {
    Serial.println(F("[+] OLED initialized."));
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(1);
    display.setCursor(0, 10);
    display.println(F("TTGO LoRa V1.3 Ready"));
    display.display();
  }

  // 3. MPU6050 IMU
  if (!mpu.begin(0x68, &Wire)) {
    Serial.println(F("[-] MPU6050 not found on I2C bus!"));
  } else {
    Serial.println(F("[+] MPU6050 initialized."));
    mpu.setAccelerometerRange(MPU6050_RANGE_8_G);
    mpu.setGyroRange(MPU6050_RANGE_500_DEG);
    mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);
  }

  // 4. DS18B20 Temp Sensor
  ds18b20.begin();
  Serial.println(F("[+] DS18B20 temperature sensor initialized."));

  // 5. GPS Serial
  gpsSerial.begin(9600, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
  Serial.println(F("[+] Hardware Serial2 started for GPS (9600 baud)."));
  delay(1500);

  // 6. LoRa Transceiver
  SPI.begin(LORA_SCK, LORA_MISO, LORA_MOSI, LORA_SS);
  LoRa.setPins(LORA_SS, LORA_RST, LORA_DIO0);

  Serial.println("[*] Starting LoRa...");
  if (!LoRa.begin(LORA_FREQ)) {
    Serial.println("[-] LoRa initialization failed!");
    loraOK = false;
  } else {
    loraOK = true;
    LoRa.setTxPower(LORA_TX_POWER);
    LoRa.setSignalBandwidth(LORA_BANDWIDTH);
    LoRa.setSpreadingFactor(LORA_SF);
    LoRa.setCodingRate4(LORA_CR);
    LoRa.setSyncWord(LORA_SYNC_WORD);
    LoRa.enableCrc();

    Serial.println("[+] LoRa initialized successfully.");
  }

  lastLoRaSend = millis() - LORA_INTERVAL + 5000;
}

// =====================================================
// LOOP
// =====================================================

void loop() {
  while (gpsSerial.available() > 0) {
    gps.encode(gpsSerial.read());
  }

  if (millis() - lastSensorUpdate > SENSOR_INTERVAL) {
    lastSensorUpdate = millis();
    readSensors();
    printSensorData();
    updateOLED();
  }

  if (millis() - lastLoRaSend >= LORA_INTERVAL) {
    lastLoRaSend = millis();
    sendLoRaPacket();
  }
}

// =====================================================
// SENSOR READING & LOGIC
// =====================================================

void readSensors() {
  ds18b20.requestTemperatures();
  currentTemp = ds18b20.getTempCByIndex(0);

  sensors_event_t a, g, tempMPU;
  mpu.getEvent(&a, &g, &tempMPU);

  currentAX = a.acceleration.x;
  currentAY = a.acceleration.y;
  currentAZ = a.acceleration.z;

  currentGX = g.gyro.x;
  currentGY = g.gyro.y;
  currentGZ = g.gyro.z;

  currentGpsValid = gps.location.isValid();
  if (currentGpsValid) {
    currentLatitude = gps.location.lat();
    currentLongitude = gps.location.lng();
  } else {
    currentLatitude = 0.0;
    currentLongitude = 0.0;
  }

  currentSatellites = gps.satellites.isValid() ? gps.satellites.value() : 0;
  currentAltitude = (currentGpsValid && gps.altitude.isValid()) ? gps.altitude.meters() : 0.0;
  currentHDOP = (currentGpsValid && gps.hdop.isValid()) ? gps.hdop.hdop() : 0.0;
}

void printSensorData() {
  Serial.println("\n==========================================");
  Serial.println("LOCAL SENSOR READINGS");
  Serial.println("------------------------------------------");
  Serial.printf("DS18B20 Temp : %.2f C\n", currentTemp);
  Serial.printf("Accel [m/s2] : X=%.2f | Y=%.2f | Z=%.2f\n", currentAX, currentAY, currentAZ);
  Serial.printf("Gyro [rad/s] : X=%.3f | Y=%.3f | Z=%.3f\n", currentGX, currentGY, currentGZ);

  if (currentGpsValid) {
    Serial.printf("GPS Location : Lat: %.6f | Lng: %.6f\n", currentLatitude, currentLongitude);
    Serial.printf("GPS Fix Stats: Sats: %lu | Alt: %.1f m | HDOP: %.2f\n", (unsigned long)currentSatellites, currentAltitude, currentHDOP);
  } else {
    Serial.println("GPS Location : Searching for satellite lock...");
    Serial.printf("GPS Satellites: %lu\n", (unsigned long)currentSatellites);
  }
  Serial.println("==========================================");
}

void sendLoRaPacket() {
  if (!loraOK) {
    Serial.println("[-] LoRa unavailable - packet not sent.");
    return;
  }

  sequenceNumber++;

  char packet[220];
  snprintf(packet, sizeof(packet),
           "NODE1,%lu,%.2f,%.2f,%.2f,%.2f,%.3f,%.3f,%.3f,%d,%.6f,%.6f,%lu,%.1f,%.2f",
           (unsigned long)sequenceNumber,
           currentTemp,
           currentAX, currentAY, currentAZ,
           currentGX, currentGY, currentGZ,
           currentGpsValid ? 1 : 0,
           currentLatitude, currentLongitude,
           (unsigned long)currentSatellites,
           currentAltitude,
           currentHDOP);

  Serial.println("\n******************************************");
  Serial.printf("LORA TX #%lu\n", (unsigned long)sequenceNumber);
  Serial.print("TX >> ");
  Serial.println(packet);

  LoRa.beginPacket();
  LoRa.print(packet);
  int result = LoRa.endPacket();

  if (result == 1) {
    Serial.println("[+] LoRa packet SENT");
  } else {
    Serial.println("[-] LoRa packet FAILED");
  }
  Serial.println("******************************************");
}

void updateOLED() {
  display.clearDisplay();
  display.setCursor(0, 0);

  if (displayPage == 0) {
    display.println("--- SENSOR READINGS ---");
    display.printf("Temp: %.2f C\n", currentTemp);
    display.printf("AccX: %.1f m/s2\n", currentAX);
    display.printf("AccY: %.1f m/s2\n", currentAY);
    display.printf("AccZ: %.1f m/s2\n", currentAZ);
    display.printf("GyroX: %.1f\n", currentGX);
    displayPage = 1;
  } else {
    display.println("--- GPS / LORA ---");
    if (currentGpsValid) {
      display.printf("Lat: %.5f\n", currentLatitude);
      display.printf("Lng: %.5f\n", currentLongitude);
      display.printf("Sats: %lu\n", (unsigned long)currentSatellites);
      display.printf("Alt: %.1fm\n", currentAltitude);
    } else {
      display.println("\nSearching GPS...");
      display.printf("Sats: %lu\n", (unsigned long)currentSatellites);
    }
    display.printf("LoRa Seq: %lu", (unsigned long)sequenceNumber);
    displayPage = 0;
  }

  display.display();
}
